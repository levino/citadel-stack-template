variable "zitadel_domain" {
  type        = string
  description = "FQDN of the ZITADEL instance."
  default     = "id.{{ domain }}"
}

variable "jwt_profile_file" {
  type        = string
  description = <<-EOT
    Path to the ZITADEL service-user key JSON used by the provider for the
    one-time bootstrap apply. Provided per session, never committed, never
    left as a standing credential (invariants 3 + 6 — see README.md).

    The documented path is: extract the chart's iam-admin JWT profile from the
    k8s secret zitadel/iam-admin, apply once, then delete the file AND the
    secret and invalidate the key (README.md step 4). That keeps the bootstrap
    fully automatable without a console step.

    Anti-pattern (do not do this): leaving that key on disk or in the cluster
    as the permanent provider credential. The rule is about persistence, not
    about use — a standing IAM-owner key that outlives the bootstrap is the
    thing that is forbidden.

    The file is gitignored and must never be committed.
  EOT
  default     = "./service-user.json"
}
