# NOTE (invariant 6): PEOPLE ARE NOT MANAGED HERE — not users, not their
# memberships, not their role grants. Only *structure* is: the org, one project
# per association, and the roles those projects can assert.
#
# The reason is not tidiness. Terraform reconciles: whatever exists in ZITADEL
# but not in this configuration is DELETED on the next apply. Every account
# created by hand and every membership granted in the console would be removed
# by an apply nobody thought was destructive. On a running instance the first
# plan is a delete plan.
#
# People are created and granted in the ZITADEL console or through its API —
# see runbooks/zitadel-identity-via-api.md. There is deliberately no escape
# hatch here: an earlier version carried a `managers` map for delegated admins,
# and a map you may fill is a map someone eventually fills.
#
# The identity model: one org = the community (shared identity pool),
# one project per association, roles per project. See README.md.
module "community" {
  source = "./modules/community"

  community_name = "{{ community_name }}"

  associations = [
{% for a in associations %}
    {
      name  = "{{ a.name }}"
      roles = [{% for r in a.roles %}"{{ r }}"{% if not loop.last %}, {% endif %}{% endfor %}]
    },
{% endfor %}
  ]
}

output "org_id" {
  value       = module.community.org_id
  description = "ZITADEL organization ID of the community."
}

output "project_ids" {
  value       = module.community.project_ids
  description = "Project IDs per association — needed when wiring OIDC clients."
}
