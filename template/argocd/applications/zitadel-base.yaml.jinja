# ZITADEL namespace + the sealed bootstrap secrets (masterkey, db-credentials).
# A plain kustomize directory (zitadel/). Until the sealed secrets are
# committed (scripts/seal-zitadel-secrets.sh), this Application is the ONLY one
# that stays OutOfSync/Degraded — the rest of the substrate is healthy.
#
# Wave 1: needs the sealed-secrets controller (cluster/, wave 0) to decrypt.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: zitadel-base
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "1"
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: community
  source:
    repoURL: https://github.com/{{ github_owner }}/{{ project_name }}
    targetRevision: main
    path: zitadel
  destination:
    server: https://kubernetes.default.svc
    namespace: zitadel
  # BEWUSST OHNE automated. ZITADEL wird einmal angelegt und danach von Hand
  # verwaltet -- Organisationen, Nutzer, Rollen, SMTP, IdPs. Deklarativ geregelt
  # ist hier nur noch die EXISTENZ: Deployment, Datenbank, Masterkey, Ingress.
  #
  # Mit selfHeal wuerde Argo jede Abweichung zurueckdrehen und prune loeschen,
  # was aus Git verschwindet. Der Inhalt liegt zwar in Postgres und wird davon
  # nicht direkt beruehrt -- aber ein Sync nach einem Chart-Upgrade laesst den
  # Setup-Job neu laufen, der wieder in FirstInstance greift.
  #
  # Argo zeigt Abweichungen weiterhin als OutOfSync an, handelt aber nicht.
  # Ein Sync passiert nur noch bewusst:
  #     kubectl -n argocd patch application <name> --type merge \
  #       -p '{"operation":{"sync":{}}}'
  syncPolicy:
    syncOptions:
      - CreateNamespace=true
    retry:
      limit: 10
      backoff:
        duration: 10s
        maxDuration: 3m
        factor: 2
